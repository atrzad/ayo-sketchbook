{
  "name": "ayo-sketchbook",
  "version": "0.1.0",
  "private": true,
  "description": "Ayo Sketchbook: cofre de notas no estilo Obsidian, com caneta no estilo Samsung Notes e a estética do Ayo Std.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
